{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "playbook/environment-profile.yml"],
  "plugin": ["./.opencode/plugin/spec-guardrails.ts"],
  "agent": {
    "analyst": {"mode": "primary", "prompt": "file://.opencode/agent/analyst.md", "permission": {"edit": "allow", "write": "allow", "bash": "deny"}},
    "orchestrator": {"mode": "primary", "prompt": "file://.opencode/agent/orchestrator.md", "permission": {"edit": "allow", "write": "allow", "bash": "allow"}},
    "builder": {"mode": "subagent", "prompt": "file://.opencode/agent/builder.md", "permission": {"edit": "allow", "write": "allow", "bash": "allow"}},
    "verifier": {"mode": "subagent", "prompt": "file://.opencode/agent/verifier.md", "permission": {"edit": "allow", "write": "allow", "bash": "allow"}}
  },
  "mcp": {
    "playwright": {"type": "remote", "url": "{env:PLAYWRIGHT_MCP_URL}", "enabled": false}
  }
}
