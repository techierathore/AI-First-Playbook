{
  "name": "@ai-first/playbook",
  "version": "0.1.0",
  "description": "Installable AI-first development playbook for OpenCode",
  "private": false,
  "publishConfig": {"access": "public"},
  "type": "module",
  "bin": {"ai-first-playbook": "scripts/install.mjs"},
  "files": [".opencode", "harness", "docs", "onboarding", "phases", "playbook", "templates", "opencode.json", "AGENTS.md", "Context-Prompt.md", "scripts", "LICENSE", "README.md"],
  "scripts": {"validate": "node scripts/playbook-validate.mjs", "test:guardrails": "node scripts/test-guardrails.mjs", "pack:check": "npm pack --dry-run", "prepublishOnly": "npm run validate && npm run test:guardrails && npm run pack:check"},
  "engines": {"node": ">=20"}
}
